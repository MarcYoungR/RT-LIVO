<launch>
<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find rt_livo)/config/m3dgr_mid360.yaml" />

	<node pkg="rt_livo" type="rtlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find rt_livo)/config/m3dgr_pinhole_m3dgr.yaml" />
	</node>

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find rt_livo)/rviz_cfg/rt_livo.rviz" />
	</group>
	
	<node pkg="image_transport" type="republish" name="republish" args="compressed in:=/camera/color/image_raw raw out:=/camera/color/image_raw" output="screen" respawn="true"/>

</launch>